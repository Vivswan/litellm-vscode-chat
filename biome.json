{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/out",
			"!**/dist",
			"!**/.vscode-test",
			"!**/.worktrees",
			"!**/*.d.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"semicolons": "always",
			"trailingCommas": "es5",
			"quoteStyle": "double"
		}
	},
	"json": {
		"formatter": {
			"enabled": false
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"noUnusedFunctionParameters": "error"
			},
			"suspicious": {
				"noExplicitAny": "error"
			},
			"style": {
				"useBlockStatements": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"src/**",
				"!src/test/**"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "error"
					}
				}
			}
		},
		{
			"includes": [
				"src/provider.ts",
				"src/provider/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"**/extension/**"
										],
										"message": "The provider layer must not import from src/extension; move shared code to src/shared."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/webview/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"vscode": "Webview code runs in the browser; talk to the extension through the dashboard protocol instead."
								},
								"patterns": [
									{
										"group": [
											"**/provider/**",
											"**/shared/**",
											"**/extension/**",
											"!**/extension/dashboard/protocol",
											"!**/extension/dashboard/recordDraft"
										],
										"message": "Webview code may import only the dashboard protocol and recordDraft modules; extension-side state stays behind the message protocol."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
