{
	"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/out", "!**/dist", "!**/.vscode-test", "!**/.worktrees", "!**/*.d.ts"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"semicolons": "always",
			"trailingCommas": "es5",
			"quoteStyle": "double"
		}
	},
	"json": {
		"formatter": {
			"enabled": false
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noLabelWithoutControl": {
					"level": "error",
					"options": {
						"inputComponents": ["Checkbox", "Input", "Radio", "Select"]
					}
				}
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"noUnusedFunctionParameters": "error"
			},
			"suspicious": {
				"noExplicitAny": "error"
			},
			"style": {
				"useBlockStatements": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/webview/dashboard/styles/theme.css"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		},
		{
			"includes": ["src/**", "!src/test/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "error"
					}
				}
			}
		},
		{
			"includes": ["src/provider/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/extension/**", "**/dashboard/**", "**/webview/**"],
										"message": "The provider layer may import only src/shared and its own tree; move shared code to src/shared."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/dashboard/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"vscode": "The dashboard-shared tree also runs inside the webview bundle; it stays pure and localizes with @vscode/l10n."
								},
								"patterns": [
									{
										"group": ["**/extension/**", "**/provider/**", "**/webview/**"],
										"message": "The dashboard-shared tree rides into the webview bundle; it may import only src/shared and its own tree."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/shared/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/provider/**", "**/extension/**", "**/dashboard/**", "**/webview/**"],
										"message": "The shared layer imports no other tree; it is the bottom of the dependency graph."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/extension/features/inline/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/commitGen/**", "**/participant/**"],
										"message": "Features may not import each other; shared code goes to src/shared, the feature's wiring seam, or the features/ root (gitApi.d.ts)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/extension/features/participant/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/inline/**", "**/commitGen/**"],
										"message": "Features may not import each other; shared code goes to src/shared, the feature's wiring seam, or the features/ root (gitApi.d.ts)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/extension/features/commitGen/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/inline/**", "**/participant/**"],
										"message": "Features may not import each other; shared code goes to src/shared, the feature's wiring seam, or the features/ root (gitApi.d.ts)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/webview/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"vscode": "Webview code runs in the browser; talk to the extension through the dashboard protocol instead."
								},
								"patterns": [
									{
										"group": [
											"**/provider/**",
											"**/shared/**",
											"**/extension/**",
											"!**/shared/config/capabilityDisplay",
											"!**/shared/config/capabilityResolution",
											"!**/shared/config/parameterResolution",
											"!**/shared/config/recordResolution",
											"!**/shared/config/settingSpec",
											"!**/shared/errorClassification",
											"!**/shared/serverEntry",
											"!**/shared/util/baseUrl",
											"!**/shared/util/displayUrl",
											"!**/shared/util/errorText",
											"!**/shared/util/json",
											"!**/shared/util/tokenCount"
										],
										"message": "Webview code may import the src/dashboard tree, its own tree, and only the allowlisted pure src/shared modules (they ride into the browser bundle); extension-side state stays behind the message protocol."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/webview/dashboard/styles/dashboard.css"],
			"linter": {
				"rules": {
					"style": {
						"noDescendingSpecificity": "off"
					}
				}
			}
		}
	],
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
