	"scripts": {
		"prepare": "husky",
		"vscode:prepublish": "tsc -p tsconfig.prod.json && bun scripts/dev/fetch-openrouter-catalog.ts && bun run bundle",
		"compile": "bun -e \"require('node:fs').rmSync('out',{recursive:true,force:true,maxRetries:5,retryDelay:100})\" && tsc -p ./",
		"bundle": "bun scripts/dev/bundle.mts --production && bun scripts/dev/generate-third-party-notices.ts",
		"bundle:dev": "bun scripts/dev/bundle.mts",
		"bundle:watch": "bun scripts/dev/bundle.mts --watch",
		"typecheck": "tsc --noEmit -p ./ && tsc --noEmit -p src/webview && tsc --noEmit -p src/test/bun && tsc --noEmit -p tsconfig.scripts.json",
		"setup-env": "bash scripts/env/setup-env.sh",
		"setup-env:verify": "bash scripts/env/setup-env.sh --verify",
		"setup-env:pwsh": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/env/setup-env.ps1",
		"l10n:extract": "bun scripts/l10n/extract.ts",
		"l10n:check": "bun scripts/l10n/check.ts",
		"lint:actions": "bun scripts/ci/lint-actions.ts",
		"lint:knip": "knip",
		"lint:types": "eslint src scripts",
		"lint": "biome lint --max-diagnostics=none .",
		"format": "biome format --write --max-diagnostics=none .",
		"watch": "tsc -watch -p ./",
		"docker:up": "bun scripts/stack/compose.ts up -d --wait",
		"docker:down": "bun scripts/stack/compose.ts down -v",
		"docker:logs": "bun scripts/stack/compose.ts logs -f",
		"dev": "bun scripts/dev/dev.ts",
		"check-overflow": "bun run bundle:dev && bun scripts/dev/check-overflow.ts",
		"check-geometry": "bun run bundle:dev && bun scripts/dev/check-geometry.ts",
		"generate-config": "bun scripts/stack/generate-litellm-config.ts",
		"copilot-login": "bun scripts/stack/copilot-login.ts",
		"test": "bun run test:host",
		"test:host": "bun run test:bun && bun run test:vscode",
		"test:vscode": "bun run compile && bun run bundle:dev && vscode-test --label unit --label activation-production --label host-fidelity --label host-fidelity-groups",
		"test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage/bun && bun run test:vscode --coverage && bun scripts/ci/check-coverage.ts",
		"test:bun": "bun test",
		"test:docker": "bun scripts/docker-test.ts"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.23",
		"@vscode/l10n": "^0.0.18",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"gpt-tokenizer": "^3.4.0",
		"openai": "^7.4.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@happy-dom/global-registrator": "^20.11.1",
		"@tailwindcss/cli": "^4.3.3",
		"@types/bun": "1.3.14",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@types/vscode": "1.125.0",
		"@vscode/l10n-dev": "^0.0.35",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^3.9.2",
		"actionlint": "^2.0.6",
		"eslint": "^10.8.0",
		"fast-check": "^4.9.0",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"knip": "^6.29.0",
		"lint-staged": "^17.2.0",
		"msw": "^2.15.0",
		"rolldown": "^1.2.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.66.0"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,css}": "biome check --write --no-errors-on-unmatched --max-diagnostics=none"
	},
	"packageManager": "bun@1.3.14"
}
