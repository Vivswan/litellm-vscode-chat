{
	"name": "litellm-vscode-chat",
	"displayName": "%litellm.displayName%",
	"description": "%litellm.description%",
	"version": "0.5.0",
	"publisher": "vivswan",
	"license": "SEE LICENSE IN LICENSE.md",
	"icon": "assets/logo.png",
	"galleryBanner": {
		"color": "#100f11",
		"theme": "dark"
	},
	"badges": [
		{
			"url": "https://img.shields.io/github/stars/Vivswan/litellm-vscode-chat?style=social",
			"description": "Star litellm-vscode-chat on Github",
			"href": "https://github.com/Vivswan/litellm-vscode-chat"
		}
	],
	"homepage": "https://github.com/Vivswan/litellm-vscode-chat",
	"repository": {
		"type": "git",
		"url": "https://github.com/Vivswan/litellm-vscode-chat"
	},
	"bugs": {
		"url": "https://github.com/Vivswan/litellm-vscode-chat/issues"
	},
	"engines": {
		"vscode": "^1.129.0"
	},
	"categories": [
		"AI",
		"Chat",
		"Machine Learning"
	],
	"keywords": [
		"litellm",
		"copilot",
		"github-copilot",
		"copilot-chat",
		"chat-provider",
		"language-model",
		"llm",
		"ai",
		"chat",
		"openai-compatible",
		"openai",
		"anthropic",
		"claude",
		"gemini",
		"azure",
		"bedrock",
		"ollama",
		"vllm",
		"openrouter",
		"proxy",
		"gateway",
		"byok",
		"bring-your-own-key",
		"self-hosted",
		"tool-calling",
		"reasoning",
		"thinking",
		"multimodal",
		"vision"
	],
	"pricing": "Free",
	"main": "./dist/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"l10n": "./l10n",
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "litellm",
				"displayName": "%litellm.provider.displayName%",
				"configuration": {
					"properties": {
						"baseUrl": {
							"type": "string",
							"title": "%litellm.provider.baseUrl.title%",
							"description": "%litellm.provider.baseUrl.description%",
							"format": "uri"
						},
						"label": {
							"type": "string",
							"title": "%litellm.provider.label.title%",
							"description": "%litellm.provider.label.description%"
						},
						"apiKey": {
							"type": "string",
							"secret": true,
							"title": "%litellm.provider.apiKey.title%",
							"description": "%litellm.provider.apiKey.description%"
						},
						"oauthTokenUrl": {
							"type": "string",
							"format": "uri",
							"title": "%litellm.provider.oauthTokenUrl.title%",
							"description": "%litellm.provider.oauthTokenUrl.description%"
						},
						"oauthClientId": {
							"type": "string",
							"title": "%litellm.provider.oauthClientId.title%",
							"description": "%litellm.provider.oauthClientId.description%"
						},
						"oauthClientSecret": {
							"type": "string",
							"secret": true,
							"title": "%litellm.provider.oauthClientSecret.title%",
							"description": "%litellm.provider.oauthClientSecret.description%"
						},
						"oauthScopes": {
							"type": "string",
							"title": "%litellm.provider.oauthScopes.title%",
							"description": "%litellm.provider.oauthScopes.description%"
						},
						"virtualKeyHeader": {
							"type": "string",
							"title": "%litellm.provider.virtualKeyHeader.title%",
							"description": "%litellm.provider.virtualKeyHeader.description%"
						},
						"virtualKeyValue": {
							"type": "string",
							"secret": true,
							"title": "%litellm.provider.virtualKeyValue.title%",
							"description": "%litellm.provider.virtualKeyValue.description%"
						}
					},
					"required": [
						"baseUrl"
					]
				}
			}
		],
		"chatParticipants": [
			{
				"id": "litellm.participant",
				"name": "litellm",
				"fullName": "LiteLLM",
				"description": "%litellm.participant.description%",
				"when": "config.litellm-vscode-chat.chatParticipant.enabled",
				"isSticky": true,
				"sampleRequest": "%litellm.participant.sampleRequest%",
				"disambiguation": [
					{
						"category": "litellm_model_catalog",
						"description": "%litellm.participant.disambiguation.catalog.description%",
						"examples": [
							"%litellm.participant.disambiguation.catalog.example1%",
							"%litellm.participant.disambiguation.catalog.example2%"
						]
					},
					{
						"category": "litellm_own_model_answer",
						"description": "%litellm.participant.disambiguation.ownModel.description%",
						"examples": [
							"%litellm.participant.disambiguation.ownModel.example1%",
							"%litellm.participant.disambiguation.ownModel.example2%"
						]
					}
				],
				"commands": [
					{
						"name": "tests",
						"description": "%litellm.participant.command.tests.description%",
						"isSticky": true,
						"sampleRequest": "%litellm.participant.command.tests.sampleRequest%",
						"disambiguation": [
							{
								"category": "litellm_test_generation",
								"description": "%litellm.participant.command.tests.disambiguation.description%",
								"examples": [
									"%litellm.participant.command.tests.disambiguation.example1%",
									"%litellm.participant.command.tests.disambiguation.example2%"
								]
							}
						]
					},
					{
						"name": "docs",
						"description": "%litellm.participant.command.docs.description%",
						"isSticky": true,
						"sampleRequest": "%litellm.participant.command.docs.sampleRequest%",
						"disambiguation": [
							{
								"category": "litellm_documentation_writing",
								"description": "%litellm.participant.command.docs.disambiguation.description%",
								"examples": [
									"%litellm.participant.command.docs.disambiguation.example1%",
									"%litellm.participant.command.docs.disambiguation.example2%"
								]
							}
						]
					},
					{
						"name": "models",
						"description": "%litellm.participant.command.models.description%",
						"isSticky": false,
						"sampleRequest": "%litellm.participant.command.models.sampleRequest%",
						"disambiguation": [
							{
								"category": "litellm_model_listing",
								"description": "%litellm.participant.command.models.disambiguation.description%",
								"examples": [
									"%litellm.participant.command.models.disambiguation.example1%",
									"%litellm.participant.command.models.disambiguation.example2%"
								]
							}
						]
					},
					{
						"name": "fix",
						"description": "%litellm.participant.command.fix.description%",
						"isSticky": true,
						"sampleRequest": "%litellm.participant.command.fix.sampleRequest%",
						"disambiguation": [
							{
								"category": "litellm_fix_diagnostic",
								"description": "%litellm.participant.command.fix.disambiguation.description%",
								"examples": [
									"%litellm.participant.command.fix.disambiguation.example1%",
									"%litellm.participant.command.fix.disambiguation.example2%"
								]
							}
						]
					},
					{
						"name": "explain",
						"description": "%litellm.participant.command.explain.description%",
						"isSticky": true,
						"sampleRequest": "%litellm.participant.command.explain.sampleRequest%",
						"disambiguation": [
							{
								"category": "litellm_explain_diagnostic",
								"description": "%litellm.participant.command.explain.disambiguation.description%",
								"examples": [
									"%litellm.participant.command.explain.disambiguation.example1%",
									"%litellm.participant.command.explain.disambiguation.example2%"
								]
							}
						]
					}
				]
			}
		],
		"languageModelTools": [
			{
				"name": "litellm_consult",
				"toolReferenceName": "litellmConsult",
				"displayName": "%litellm.tool.consult.displayName%",
				"userDescription": "%litellm.tool.consult.userDescription%",
				"modelDescription": "Ask a second, independently configured LiteLLM model for its opinion, and get its answer back as text. Reach for it when you want a second opinion before committing to an approach, when you want a plan, a diagnosis or a piece of reasoning sanity-checked, or when a model with different strengths than yours is likely to know better. The other model sees NOTHING of this conversation: send a question that stands on its own, and put the code, errors, or background it needs into 'context'. It only answers - it cannot read files, run commands, or change anything - so act on its answer yourself, and treat it as one opinion rather than as fact.",
				"canBeReferencedInPrompt": true,
				"icon": "$(comment-discussion)",
				"when": "litellm.consultToolReady",
				"inputSchema": {
					"type": "object",
					"properties": {
						"question": {
							"type": "string",
							"description": "The self-contained question to ask. State what you want to know and what a useful answer would look like; the other model sees only this and 'context'."
						},
						"context": {
							"type": "string",
							"description": "Optional background the question depends on: the relevant code, an error message, the constraints, what you already tried. Include what a colleague would need to answer without asking follow-up questions."
						}
					},
					"required": [
						"question"
					]
				}
			}
		],
		"mcpServerDefinitionProviders": [
			{
				"id": "litellm.mcpServers",
				"label": "%litellm.mcp.label%"
			}
		],
		"commands": [
			{
				"command": "litellm.manage",
				"title": "%litellm.command.manage.title%"
			},
			{
				"command": "litellm.openDashboard",
				"title": "%litellm.command.openDashboard.title%"
			},
			{
				"command": "litellm.testConnection",
				"title": "%litellm.command.testConnection.title%"
			},
			{
				"command": "litellm.syncModels",
				"title": "%litellm.command.syncModels.title%"
			},
			{
				"command": "litellm.showDiagnostics",
				"title": "%litellm.command.showDiagnostics.title%"
			},
			{
				"command": "litellm.helpAndFeedback",
				"title": "%litellm.command.helpAndFeedback.title%"
			},
			{
				"command": "litellm.setServerSecret",
				"title": "%litellm.command.setServerSecret.title%"
			},
			{
				"command": "litellm.reportIssue",
				"title": "%litellm.command.reportIssue.title%"
			},
			{
				"command": "litellm.refreshUsage",
				"title": "%litellm.command.refreshUsage.title%"
			},
			{
				"command": "litellm.refreshOpenRouterCatalog",
				"title": "%litellm.command.refreshOpenRouterCatalog.title%"
			},
			{
				"command": "litellm.exportSettings",
				"title": "%litellm.command.exportSettings.title%"
			},
			{
				"command": "litellm.importSettings",
				"title": "%litellm.command.importSettings.title%"
			},
			{
				"command": "litellm.undoLastImport",
				"title": "%litellm.command.undoLastImport.title%"
			},
			{
				"command": "litellm.generateCommitMessage",
				"title": "%litellm.command.generateCommitMessage.title%",
				"icon": "$(sparkle)"
			},
			{
				"command": "litellm.generatePrDescription",
				"title": "%litellm.command.generatePrDescription.title%"
			}
		],
		"menus": {
			"scm/title": [
				{
					"command": "litellm.generateCommitMessage",
					"when": "config.litellm-vscode-chat.commitGeneration.enabled && scmProvider == git",
					"group": "navigation"
				}
			],
			"commandPalette": [
				{
					"command": "litellm.generateCommitMessage",
					"when": "config.litellm-vscode-chat.commitGeneration.enabled"
				},
				{
					"command": "litellm.generatePrDescription",
					"when": "config.litellm-vscode-chat.prGeneration.enabled"
				}
			]
		},
		"walkthroughs": [
			{
				"id": "litellm.gettingStarted",
				"title": "%litellm.walkthrough.title%",
				"description": "%litellm.walkthrough.description%",
				"steps": [
					{
						"id": "litellm.walkthrough.connectServer",
						"title": "%litellm.walkthrough.connectServer.title%",
						"description": "%litellm.walkthrough.connectServer.description%",
						"media": {
							"markdown": "assets/walkthrough/connect-server.md"
						},
						"completionEvents": [
							"onCommand:litellm.openDashboard"
						]
					},
					{
						"id": "litellm.walkthrough.pickModel",
						"title": "%litellm.walkthrough.pickModel.title%",
						"description": "%litellm.walkthrough.pickModel.description%",
						"media": {
							"markdown": "assets/walkthrough/pick-model.md"
						},
						"completionEvents": [
							"onCommand:workbench.action.chat.open"
						]
					},
					{
						"id": "litellm.walkthrough.configureModel",
						"title": "%litellm.walkthrough.configureModel.title%",
						"description": "%litellm.walkthrough.configureModel.description%",
						"media": {
							"markdown": "assets/walkthrough/configure-model.md"
						},
						"completionEvents": [
							"onStepSelected"
						]
					},
					{
						"id": "litellm.walkthrough.verifyConnection",
						"title": "%litellm.walkthrough.verifyConnection.title%",
						"description": "%litellm.walkthrough.verifyConnection.description%",
						"media": {
							"markdown": "assets/walkthrough/verify-connection.md"
						},
						"completionEvents": [
							"onCommand:litellm.testConnection"
						]
					},
					{
						"id": "litellm.walkthrough.fineTune",
						"title": "%litellm.walkthrough.fineTune.title%",
						"description": "%litellm.walkthrough.fineTune.description%",
						"media": {
							"markdown": "assets/walkthrough/fine-tune.md"
						},
						"completionEvents": [
							"onCommand:workbench.action.openSettings"
						]
					},
					{
						"id": "litellm.walkthrough.generateCommit",
						"title": "%litellm.walkthrough.generateCommit.title%",
						"description": "%litellm.walkthrough.generateCommit.description%",
						"media": {
							"markdown": "assets/walkthrough/generate-commit.md"
						},
						"completionEvents": [
							"onCommand:litellm.generateCommitMessage"
						]
					},
					{
						"id": "litellm.walkthrough.generatePr",
						"title": "%litellm.walkthrough.generatePr.title%",
						"description": "%litellm.walkthrough.generatePr.description%",
						"media": {
							"markdown": "assets/walkthrough/generate-pr.md"
						},
						"completionEvents": [
							"onCommand:litellm.generatePrDescription"
						]
					},
					{
						"id": "litellm.walkthrough.inlineCompletions",
						"title": "%litellm.walkthrough.inlineCompletions.title%",
						"description": "%litellm.walkthrough.inlineCompletions.description%",
						"media": {
							"markdown": "assets/walkthrough/inline-completions.md"
						},
						"completionEvents": [
							"onSettingChanged:litellm-vscode-chat.inlineCompletions.enabled"
						]
					}
				]
			}
		],
		"configuration": [
			{
				"title": "%litellm.config.section.servers%",
				"properties": {
					"litellm-vscode-chat.servers": {
						"type": "array",
						"scope": "machine",
						"default": [],
						"markdownDescription": "%litellm.config.servers.description%",
						"items": {
							"type": "object",
							"required": [
								"label",
								"baseUrl"
							],
							"additionalProperties": false,
							"properties": {
								"label": {
									"type": "string",
									"description": "%litellm.config.servers.label.description%"
								},
								"baseUrl": {
									"type": "string",
									"format": "uri",
									"description": "%litellm.config.servers.baseUrl.description%"
								},
								"apiVersion": {
									"type": "string",
									"description": "%litellm.config.servers.apiVersion.description%"
								},
								"auth": {
									"type": "object",
									"additionalProperties": false,
									"minProperties": 1,
									"markdownDescription": "%litellm.config.servers.auth.description%",
									"properties": {
										"apiKey": {
											"type": "string",
											"description": "%litellm.config.servers.auth.apiKey.description%"
										},
										"oauth": {
											"type": "object",
											"additionalProperties": false,
											"required": [
												"tokenUrl",
												"clientId"
											],
											"markdownDescription": "%litellm.config.servers.auth.oauth.description%",
											"properties": {
												"tokenUrl": {
													"type": "string",
													"format": "uri",
													"description": "%litellm.config.servers.auth.oauth.tokenUrl.description%"
												},
												"clientId": {
													"type": "string",
													"description": "%litellm.config.servers.auth.oauth.clientId.description%"
												},
												"clientSecret": {
													"type": "string",
													"description": "%litellm.config.servers.auth.oauth.clientSecret.description%"
												},
												"scopes": {
													"type": "string",
													"description": "%litellm.config.servers.auth.oauth.scopes.description%"
												},
												"apiKey": {
													"type": "string",
													"description": "%litellm.config.servers.auth.oauth.apiKey.description%"
												},
												"virtualKey": {
													"type": "object",
													"additionalProperties": false,
													"required": [
														"header"
													],
													"description": "%litellm.config.servers.auth.oauth.virtualKey.description%",
													"properties": {
														"header": {
															"type": "string",
															"description": "%litellm.config.servers.auth.virtualKey.header.description%"
														},
														"value": {
															"type": "string",
															"description": "%litellm.config.servers.auth.virtualKey.value.description%"
														}
													}
												}
											}
										},
										"virtualKey": {
											"type": "object",
											"additionalProperties": false,
											"required": [
												"header"
											],
											"markdownDescription": "%litellm.config.servers.auth.virtualKey.description%",
											"properties": {
												"header": {
													"type": "string",
													"description": "%litellm.config.servers.auth.virtualKey.header.description%"
												},
												"value": {
													"type": "string",
													"description": "%litellm.config.servers.auth.virtualKey.value.description%"
												}
											}
										}
									}
								},
								"headers": {
									"type": "object",
									"description": "%litellm.config.servers.headers.description%",
									"additionalProperties": {
										"type": [
											"string",
											"number",
											"boolean"
										]
									}
								},
								"models": {
									"type": "object",
									"additionalProperties": false,
									"markdownDescription": "%litellm.config.servers.models.description%",
									"properties": {
										"parameters": {
											"type": "object",
											"additionalProperties": {
												"type": "object"
											},
											"description": "%litellm.config.servers.models.parameters.description%"
										},
										"capabilities": {
											"type": "object",
											"additionalProperties": {
												"type": "object"
											},
											"description": "%litellm.config.servers.models.capabilities.description%"
										}
									}
								},
								"discovery": {
									"type": "object",
									"additionalProperties": false,
									"markdownDescription": "%litellm.config.servers.discovery.description%",
									"properties": {
										"expectedFailures": {
											"type": "array",
											"items": {
												"type": "string",
												"enum": [
													"modelListing",
													"modelInfo"
												]
											},
											"uniqueItems": true,
											"description": "%litellm.config.servers.discovery.expectedFailures.description%"
										},
										"declared": {
											"type": "array",
											"items": {
												"type": "string"
											},
											"uniqueItems": true,
											"description": "%litellm.config.servers.discovery.declared.description%"
										}
									}
								},
								"budget": {
									"type": "number",
									"exclusiveMinimum": 0,
									"description": "%litellm.config.servers.budget.description%"
								},
								"mcp": {
									"type": [
										"boolean",
										"object"
									],
									"additionalProperties": false,
									"markdownDescription": "%litellm.config.servers.mcp.description%",
									"properties": {
										"url": {
											"type": "string",
											"format": "uri",
											"description": "%litellm.config.servers.mcp.url.description%"
										}
									}
								}
							}
						}
					}
				}
			},
			{
				"title": "%litellm.config.section.models%",
				"properties": {
					"litellm-vscode-chat.models.parameters": {
						"type": "object",
						"default": {},
						"markdownDescription": "%litellm.config.models.parameters.description%",
						"additionalProperties": {
							"type": "object"
						}
					},
					"litellm-vscode-chat.models.capabilities": {
						"type": "object",
						"default": {},
						"markdownDescription": "%litellm.config.models.capabilities.description%",
						"additionalProperties": {
							"type": "object"
						}
					},
					"litellm-vscode-chat.models.openRouterCatalog": {
						"type": "boolean",
						"default": true,
						"description": "%litellm.config.models.openRouterCatalog.description%"
					}
				}
			},
			{
				"title": "%litellm.config.section.chat%",
				"properties": {
					"litellm-vscode-chat.chat.timeout": {
						"type": "number",
						"default": 300000,
						"minimum": 1000,
						"description": "%litellm.config.chat.timeout.description%"
					},
					"litellm-vscode-chat.chat.maxToolsPerRequest": {
						"type": "integer",
						"default": 128,
						"minimum": 1,
						"description": "%litellm.config.chat.maxToolsPerRequest.description%"
					},
					"litellm-vscode-chat.chat.additionalToolSchemaKeywords": {
						"type": "array",
						"default": [],
						"items": {
