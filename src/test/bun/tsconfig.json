{
	"extends": "../../webview/tsconfig.json",
	"compilerOptions": {
		"types": [
			"bun"
		],
		// The webview project pins ES2022 and the root project checks host-side
		// source at ES2024; this project spans both worlds, so it takes the union.
		"lib": [
			"ES2024",
			"DOM",
			"DOM.Iterable"
		],
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	},
	"include": [
		"./**/*",
		"../../webview/**/*",
		"../../dashboard/**/*",
		// The host-side source this project pulls in references the "vscode"
		// module's augmented types; the ambient declarations must ride along or
		// those imports fail to resolve.
		"../../vscodeApi.d.ts"
	]
}
