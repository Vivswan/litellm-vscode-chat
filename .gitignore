# Agent configs: only the checked-in settings/hooks files are tracked
.claude/*
!.claude/settings.json
.codex/*
!.codex/hooks.json
.impeccable/

# IDEs and editors
.idea/

# Generated at bundle time from runtime dependencies' license files
ThirdPartyNotices.txt

# Auto-generated VS Code type definitions
/vscode.d.ts

# npm lockfile (using Bun instead)
package-lock.json

# Husky's generated hook runtime - except the tracked bootstrap files that
# keep the hook layer fail-closed in fresh worktrees (a directory exclude
# would forbid the re-inclusions, hence the file glob). A new hook script
# needs its shim re-included here; hooksFailClosed.test.ts derives the
# required set from the tracked hook scripts and fails without it.
.husky/_/*
!.husky/_/pre-commit
!.husky/_/commit-msg
!.husky/_/h

# One-shot seed dropped by `bun run dev`, consumed on activation
.dev-seed.json

# Dedicated persistent profile for the dev launcher's Extension Development
# Host; scripts/dev/dev.ts wipes it whenever the seed configuration changes
.dev-profile/

# Runtime-generated LiteLLM proxy config (scripts/stack/litellmConfig.ts); every
# stack startup path regenerates it
docker/.generated/

# GitHub Copilot device-flow token seeded by `bun run copilot-login`; the
# directory itself is tracked (via .gitkeep) so docker-compose always has
# its mountpoint on a fresh checkout
docker/.copilot-token/*
!docker/.copilot-token/.gitkeep

# Local screenshot output from the render harness (design review material)
/renders/

# Agent scratch probes (throwaway measurement fixtures/scripts); cleaned up
# after use, ignored so a forgotten one can never land in a commit
.probe*

# BEGIN REPO-PLATFORM MANAGED
# Generated from github/gitignore - do not edit between the BEGIN/END
# markers; repository-local patterns live outside the managed region
# (above BEGIN, or below END where last-match-wins can override).

