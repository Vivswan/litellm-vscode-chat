# Configuration for the local LiteLLM docker stack (docker-compose.yml).
# Copy to .env and fill in only what you need; everything has a working
# default.

# Real provider keys. The stack's LiteLLM config is generated at startup
# (docker/.generated/litellm-config.yaml), and a wildcard route (openai/* or
# anthropic/*) is emitted only when its key is set here or in the
# environment - no key, no route, no phantom catalog models. A set key also
# turns on LiteLLM's check_provider_endpoint, which expands the wildcard
# into the provider's live catalog on /v1/models (for direct API consumers;
# the extension's picker lists the wildcard route itself). The docker test
# suite always generates without these routes, so keys here never change
# test results.
# GitHub Copilot models need a device-flow login instead of a key here:
# `bun run copilot-login` once, and every stack start emits a
# github_copilot/<model> route per model in your live Copilot catalog.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Set to 1 to also emit a bare "*" passthrough route for any other
# provider/model LiteLLM can infer.
LITELLM_WILDCARD_ALL=

# Proxy admin key; the docker test suite expects this default.
LITELLM_MASTER_KEY=sk-test-1234

# Host ports.
LITELLM_PORT=4000
FAKE_OPENAI_PORT=8090
