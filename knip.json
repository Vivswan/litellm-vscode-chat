{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"src/extension.ts",
		"src/webview/dashboard/index.tsx",
		"src/test/**/*.test.ts",
		"src/test/**/*.test.tsx",
		"src/test/testUtils.ts",
		"src/test/capture-server.ts",
		"src/test/util/fingerprintSalt.ts",
		"scripts/**/*.ts",
		"scripts/**/*.mts",
		".vscode-test.mjs"
	],
	"project": [
		"src/**/*.{ts,tsx}",
		"scripts/**/*.{ts,mts}"
	],
	"ignoreExportsUsedInFile": false,
	"ignoreDependencies": [
		"@vscode/test-electron",
		"@tailwindcss/cli",
		"tailwindcss"
	],
	"ignoreBinaries": [
		"pwsh",
		"down",
		"logs"
	]
}
