{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"src/extension.ts",
		"src/webview/dashboard/index.tsx",
		"src/test/**/*.test.ts",
		"src/test/**/*.test.tsx",
		"src/test/capture-server.ts",
		"src/test/util/fingerprintSalt.ts",
		"src/test/util/buildDefines.ts",
		"src/test/bun/scripts/lint/outputChannelWritesFixture.ts",
		"src/test/bun/scripts/lint/userTextReadersFixture.ts",
		"src/test/bun/scripts/lint/userTextReadersCleanFixture.ts",
		"scripts/dev/render-dashboard.ts",
		"scripts/dev/render-icon.ts",
		"scripts/dev/renderFixtures/*.ts",
		"!scripts/dev/renderFixtures/shared.ts",
		"scripts/dev/seed-demo-usage.ts",
		"scripts/stack/fake-openai-server.ts",
		".vscode-test.mjs"
	],
	"project": [
		"src/**/*.{ts,tsx,css}",
		"scripts/**/*.{ts,mts}"
	],
	"ignoreExportsUsedInFile": false,
	"ignoreDependencies": [
		"@vscode/test-electron",
		"@tailwindcss/cli"
	],
	"ignoreBinaries": [
		"down",
		"logs"
	]
}
