# This file is managed by Vivswan/repo-platform.
# Local edits are replaced on the next sync.
# The key win is key-duplicates: YAML loaders silently keep the last value,
# so nothing else in the CI gate would catch a duplicated key.
extends: default

ignore:
  - .venv
  - node_modules
  - dist
  - build
  - coverage
  # Local git worktrees (some repos keep them under .worktrees/); CI never
  # sees them, but local yamllint runs scan the filesystem.
  - .worktrees

rules:
  document-start: disable # no --- preamble required
  line-length: disable # workflow `if:` expressions run long
  truthy:
    check-keys: false # GitHub workflows' `on:` key is fine
  comments:
    min-spaces-from-content: 1
