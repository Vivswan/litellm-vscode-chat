{
	"name": "LiteLLM VS Code Chat",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
	"hostRequirements": {
		"cpus": 4,
		"memory": "8gb",
		"storage": "32gb"
	},
	"features": {
		"ghcr.io/devcontainers-extra/features/bun:1": {
			"version": "1.4.0"
		},
		"ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {}
	},
	"onCreateCommand": "bash .devcontainer/install-test-deps.sh && bash scripts/env/setup-env.sh",
	// Best-effort prefetch of the test stack's images; pulls are incremental,
	// so this is a no-op when they are already present. The `|| true` keeps a
	// start without docker or network from failing.
	"postStartCommand": "docker compose -f docker/docker-compose.yml --project-directory . pull --quiet || true",
	"forwardPorts": [4000, 8090],
	"portsAttributes": {
		"4000": { "label": "LiteLLM proxy" },
		"8090": { "label": "fake-openai" }
	},
	"customizations": {
		"vscode": {
			"settings": {
				"editor.defaultFormatter": "biomejs.biome",
				"editor.formatOnSave": true,
				"editor.codeActionsOnSave": {
					"source.organizeImports.biome": "explicit"
				}
			},
			"extensions": ["biomejs.biome", "dbaeumer.vscode-eslint"]
		}
	}
}
