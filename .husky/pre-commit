#!/bin/sh

# Pre-commit hooks:
#   allowed:   check -> fail        |  check -> fail -> write the fix into the working tree -> fail
#   forbidden: changing the commit (stage, commit, format-and-restage); any writing git command
#              (stash, checkout, reset, push, config); anything else (fix-then-pass, network)
#   read-only `git diff --cached --name-only` is fine; the developer reruns the commit
# This hook writes nothing; its only git is that read-only diff; a refused check names its fix command when one exists.

# First, before anything that needs an install: the .husky/_ bootstrap files are tracked so git always finds a hook to
# run, and a checkout that never ran bun install lands here instead of silently committing with no hooks at all.
if [ ! -d node_modules ]; then
	echo "Dependencies are missing. Run 'bun install' in this checkout before committing (fresh worktrees start without node_modules)."
	exit 1
fi

# check:static reads the working tree, not the index; about twenty seconds.
if ! bun run check:static; then
	echo "pre-commit: refused; nothing was written. Fix what the failing check reported above (when a command exists it is named: bun run format, bun run manifest:generate, bun run docs:settings, bun run l10n:extract; otherwise edit the reported source or translation and rerun bun run check:static), stage, and commit again."
	exit 1
fi

# The bun tree, narrowed to what the staged change can reach: the staged bun test files plus every bun test whose
# runtime imports reach a staged file (scripts/dev/changed-bun-tests.ts prints them and says why on one line). The
# whole tree, the VS Code host suite on three OSes, the docker stacks, and fuzz are CI's to judge on every push; run
# here, the whole tree tripped per-test budgets on suites the change never touched. A selection error refuses the
# commit, so the tests are never skipped silently.
if ! selected=$(bun scripts/dev/changed-bun-tests.ts); then
	echo "pre-commit: refused; the bun test selection failed (above), so no bun test ran. Nothing was written."
	exit 1
fi
if [ -n "$selected" ]; then
	# Split on newlines only, with globbing off, so a name with a space or a bracket stays one whole argument.
	set -f
	IFS='
'
	bun test $selected
fi
