#!/bin/sh

# Refuse to install dependencies during a commit; they should already exist.
# This guard is the fail-closed floor for fresh worktrees: the .husky/_
# bootstrap files are tracked so git always finds a hook to run, and a
# checkout that never ran bun install lands here instead of silently
# committing with no hooks at all.
if [ ! -d node_modules ]; then
	echo "Dependencies are missing. Run 'bun install' in this checkout before committing (fresh worktrees start without node_modules)."
	exit 1
fi

# Format, apply safe lint fixes, and sort imports on staged files only;
# repo-wide formatting is CI's job (biome ci and the auto-format workflow).
bunx lint-staged

# Regenerate the committed generated files (the manifest blocks, the settings docs) and stage them, in one run: every
# generator's refusal of an unstaged edit to its inputs or outputs, and every render, comes before any write, so a
# refused commit leaves the tree as it was. CI's --check is the backstop for a --no-verify commit or a web edit, not
# the reminder. After lint-staged, so the generators read the final tree; before check:static, so its manifest and docs
# checks pass by construction here and stay the manual and CI gate.
bun scripts/dev/stageGenerated.ts

# The static gates: workflow lint, the @types/vscode versus engines.vscode guard (the same script CI's format-check
# runs), lint, the typecheck of all four tsconfig projects (`compile` builds the root one alone, and a webview type
# error once reached main through that gap), the l10n gate, and the two generator drift checks (the generated manifest
# blocks, the settings reference). About twenty seconds together.
bun run check:static

# The bun tree only, through its launcher (scripts/bun-test.ts), which drops every GIT_* variable git exports to this
# hook before bun starts and keeps the hook's index only under LVT_HOOK_GIT_INDEX_FILE. The VS Code host suite
# (compile, bundle, and the four vscode-test labels) is CI's to judge on every push, on three OSes; running it here too
# cost each commit minutes for a verdict the push repeats.
bun run test:bun

# Lints and tests above ran against the working tree, not the index. Two exceptions: the staging run enforces
# index-consistency for the generated files itself, and hooksFailClosed reads the staged .husky files through the
# launcher's stash of this hook's index, LVT_HOOK_GIT_INDEX_FILE.
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
	echo "note: unstaged or untracked changes present; lint and test results reflect the working tree, not the exact commit."
fi
