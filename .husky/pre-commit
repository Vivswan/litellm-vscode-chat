#!/bin/sh

# A pre-commit hook may check and fail, or check, fail, write the fix into the working tree, and still fail. Forbidden:
# changing what the commit contains (no stage, no commit, no formatter-and-restage step) and anything else (no
# fix-then-pass, no git command that writes: stash, checkout, reset, push, config; no network). The read-only query that
# shows what is staged (`git diff --cached --name-only`) stays. The developer reruns the commit. This hook is the first
# shape: it writes nothing, runs no git, and a refused check names the command that fixes it.

# First, before anything that needs an install: the .husky/_ bootstrap files are tracked so git always finds a hook to
# run, and a checkout that never ran bun install lands here instead of silently committing with no hooks at all.
if [ ! -d node_modules ]; then
	echo "Dependencies are missing. Run 'bun install' in this checkout before committing (fresh worktrees start without node_modules)."
	exit 1
fi

# The static gates, read against the working tree: workflow lint, the @types/vscode versus engines.vscode guard, biome
# (formatting, lint, import order), the typecheck of all four tsconfig projects (`compile` builds the root one alone,
# and a webview type error once reached main through that gap), the l10n gate, and the two generator drift checks (the
# generated manifest blocks, the settings reference). About twenty seconds together.
if ! bun run check:static; then
	echo "pre-commit: refused; nothing was written. Fix what the failing check reported above (it names the command when one exists: bun run format, bun run manifest:generate, bun run docs:settings, bun run l10n:extract), stage, and commit again."
	exit 1
fi

# The bun tree only. The VS Code host suite (compile, bundle, and the four vscode-test labels) is CI's to judge on
# every push, on three OSes; running it here too cost each commit minutes for a verdict the push repeats.
bun test
