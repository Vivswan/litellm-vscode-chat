#!/bin/sh

# Refuse to mutate the repo during commits. Dependencies should already exist.
if [ ! -d node_modules ]; then
	echo "Dependencies are missing. Run 'bun install' before committing."
	exit 1
fi

# Format, apply safe lint fixes, and sort imports on staged files only;
# repo-wide formatting is CI's job (biome ci and the auto-format workflow).
bunx lint-staged

# Lint GitHub Actions workflows
bun run lint:actions

# Verify @types/vscode matches engines.vscode
node -e "
const pkg = require('./package.json');
const engVer = pkg.engines.vscode.replace(/[^0-9.]/g, '');
const typesRange = pkg.devDependencies['@types/vscode'];
const typesVer = typesRange.replace(/[^0-9.]/g, '');
const [eM, em] = engVer.split('.').map(Number);
const [tM, tm] = typesVer.split('.').map(Number);
if (tM > eM || (tM === eM && tm > em)) {
  console.error('❌ @types/vscode ' + typesRange + ' is newer than engines.vscode ' + pkg.engines.vscode);
  console.error('   Bump engines.vscode or downgrade @types/vscode to fix.');
  process.exit(1);
}
"

# Run linting
bun run lint

# Type-check the bun-run helper scripts (not covered by compile)
bunx tsc --noEmit -p tsconfig.scripts.json

# Localization gate: bundle extraction drift and translation-file parity
bun run l10n:check

# Run tests
bun run test

# Lints and tests above ran against the working tree, not the index.
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
	echo "note: unstaged or untracked changes present; lint and test results reflect the working tree, not the exact commit."
fi
