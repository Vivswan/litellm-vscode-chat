#!/bin/sh

# Refuse to mutate the repo during commits. Dependencies should already exist.
# This guard is the fail-closed floor for fresh worktrees: the .husky/_
# bootstrap files are tracked so git always finds a hook to run, and a
# checkout that never ran bun install lands here instead of silently
# committing with no hooks at all.
if [ ! -d node_modules ]; then
	echo "Dependencies are missing. Run 'bun install' in this checkout before committing (fresh worktrees start without node_modules)."
	exit 1
fi

# Format, apply safe lint fixes, and sort imports on staged files only;
# repo-wide formatting is CI's job (biome ci and the auto-format workflow).
bunx lint-staged

# Lint GitHub Actions workflows
bun run lint:actions

# Verify the installed @types/vscode stays within engines.vscode. The same
# script CI's format-check runs: this once compared the DECLARED range while
# CI compared the INSTALLED version, so a caret range that resolved past the
# floor was green here and red on main.
bun scripts/ci/check-vscode-types.ts

# Run linting
bun run lint

# Type-check every tsconfig project. NOT just the helper scripts, and not just
# what `compile` covers: `compile` builds the ROOT project alone, so a type
# error anywhere in src/webview (the dashboard) or src/test/bun passed this hook
# and every local check that looked like typechecking, and was caught only by
# CI. That is how a deterministic error reached main three commits running.
# Runs before the tests because it costs about seven seconds against their
# minutes, and a type error should not wait behind a suite that cannot pass.
bun run typecheck

# Localization gate: bundle extraction drift and translation-file parity
bun run l10n:check

# Run tests
bun run test

# Lints and tests above ran against the working tree, not the index.
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
	echo "note: unstaged or untracked changes present; lint and test results reflect the working tree, not the exact commit."
fi
